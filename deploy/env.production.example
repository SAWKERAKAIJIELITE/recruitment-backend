# Production settings of the recruitment backend (docs/deployment.md, step 6).
# Copy to /var/www/recruitment/.env, fill the values marked «change», then: chmod 640 .env
# After any change here: php artisan config:cache, then sudo systemctl reload php8.3-fpm

APP_NAME="نظام التوظيف"
APP_ENV=production
# Filled once by: php artisan key:generate --force. Keep it (the backup saves .env); do not change it later.
APP_KEY=
# Never true in production: error pages would show code and settings.
APP_DEBUG=false
# «change»: the address the staff open.
APP_URL=https://hr.example.local
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

# One log file a day in storage/logs, kept 30 days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=recruitment
DB_USERNAME=recruitment_app
# «change»: the password given to the database role (step 4).
DB_PASSWORD=

# The API keeps no session and queues nothing; the cache holds the rate limits and the scheduler's locks.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
MAIL_MAILER=log

# Behind another reverse proxy or load balancer only: its address(es), comma-separated. Never "*" when the
# server can also be reached directly. Empty when nginx on this server is the only proxy.
TRUSTED_PROXIES=

# «change»: the exam halls' networks. Candidates log in only from these (addresses or CIDR ranges,
# comma-separated); empty refuses every candidate.
EXAMS_CANDIDATE_NETWORKS=10.20.30.0/24
# A candidate may start until this many minutes after the start; candidates may log in this long before it.
EXAMS_LATE_MINUTES=15
EXAMS_LOGIN_EARLY_MINUTES=60
EXAMS_CANDIDATE_TOKEN_MINUTES=360

# The organization's day: staff tokens end at its midnight; report periods and contract dates follow it.
REPORTS_TIMEZONE=Asia/Damascus
REPORTS_ORGANIZATION="وزارة الدفاع السورية"
REPORTS_DEPARTMENT="إدارة التوجيه المعنوي  |  فرع القوة البشرية ــ قسم التوظيف"
REPORTS_MILITARY_ENTITY="التوجيه المعنوي"
# A PNG or JPG printed in the reports' header (optional).
# REPORTS_LOGO=/var/www/recruitment/storage/app/reports/logo.png
REPORTS_MAX_XLSX_ROWS=20000
REPORTS_MAX_PDF_ROWS=2000

CONTRACTS_ISSUING_UNIT="إدارة التوجيه المعنوي"
CONTRACTS_REMINDER_DAYS=14
CONTRACTS_VACANCY_MONTHS=3

# Upload limits in kilobytes. nginx (client_max_body_size) and PHP (upload_max_filesize) must allow the largest.
IMPORTS_MAX_FILE_KILOBYTES=30720
IMPORTS_MAX_ROWS=2000
DOCUMENTS_MAX_FILE_KILOBYTES=10240
CONTRACTS_VACANCIES_MAX_FILE_KILOBYTES=5120

# Only used when the frontend is served from another address than the API (not the guide's layout).
CORS_ALLOWED_ORIGINS=https://hr.example.local
