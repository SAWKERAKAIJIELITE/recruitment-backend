# What the site serves, in both layouts (imported by Caddyfile and Caddyfile.standalone): the frontend's build
# at /, the API at /api, the desktop app's updates at /desktop, on one address.

encode zstd gzip

# The largest upload: candidate imports up to 30 MB (IMPORTS_MAX_FILE_KILOBYTES), documents 10 MB.
request_body {
    max_size 34MB
}

header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Strict-Transport-Security "max-age=31536000"
    -Server
}

# The API's documentation page (Scramble: /docs/api), only when API_DOCS_ENABLED=true. Laravel checks the same
# setting, so the page stays closed unless both the web and the app containers have it.
@docs {
    path /docs/api /docs/api.json
    expression {$API_DOCS_ENABLED:false}
}

# In the order written: the first block that matches answers.
route {
    # The API. Only Laravel's front controller (public/index.php) runs; nothing else of the backend is in this
    # container.
    handle /api/* {
        root * /var/www/recruitment/public
        php_fastcgi app:9000 {
            # Large imports, approvals and exports take time (PHP's max_execution_time is 180 too).
            read_timeout 180s
        }
    }

    handle @docs {
        root * /var/www/recruitment/public
        php_fastcgi app:9000
    }

    # The desktop app's updates (electron-updater): latest.yml, the installers and their .blockmap files, from the
    # desktop-releases volume. The desktop-sync service copies them there from GitHub (docs/docker-deployment.md,
    # step 13); nothing is ever uploaded through the site. Files only: no listing, and a missing file is 404, never the frontend's index.html.
    handle /desktop {
        respond 404
    }

    handle_path /desktop/* {
        root * /srv/desktop

        # The manifest says which version is current: never kept by a browser, by Cloudflare or by any cache.
        @manifest path *.yml *.yaml
        header @manifest {
            Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
            CDN-Cache-Control "no-store"
            Cloudflare-CDN-Cache-Control "no-store"
        }

        # An installer and its blockmap never change under their name (the version is in it): kept a year. Only
        # when the file is there: a 404 kept a year by Cloudflare would hide the file once it is copied in.
        @installers {
            path *.exe *.blockmap *.msi *.zip *.7z
            file
        }
        header @installers Cache-Control "public, max-age=31536000, immutable"

        # A missing file (404) is never kept, by anyone: it may be copied in a minute later.
        @missing not file
        header @missing {
            Cache-Control "no-store"
            CDN-Cache-Control "no-store"
            Cloudflare-CDN-Cache-Control "no-store"
        }

        # No «browse»: a folder is never listed. Dot files (a latest.yml being written) are never served.
        file_server {
            hide .*
        }
    }

    # The frontend, a single-page app: an unknown path is its index.html.
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}

log
