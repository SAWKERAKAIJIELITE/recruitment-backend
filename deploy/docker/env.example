# Settings of the recruitment system under Docker (docs/docker-deployment.md, step 3).
# Copy to .env next to docker-compose.yml, fill the values marked «change», then: chmod 600 .env
# After any change here: docker compose up -d   (the containers are made again with the new values)
#
# Passwords: letters and digits only (openssl rand -hex 24), so that no character needs quoting here.

# ---- Docker ---------------------------------------------------------------------------------------------------
# The address the site answers on. A public name gets a Let's Encrypt certificate automatically.
SITE_ADDRESS=rec.1005.date
# «change»: the PostgreSQL superuser's password (administration and backups only; the application does not use it).
DB_SUPERUSER_PASSWORD=
# false: the app container does not run the migrations when it starts.
AUTO_MIGRATE=true

# ---- The application --------------------------------------------------------------------------------------------
APP_NAME="نظام التوظيف"
APP_ENV=production
# «change», once: docker compose run --rm --no-deps app php artisan key:generate --show
# Keep it (the backup saves .env); do not change it later.
APP_KEY=
# Never true in production: error pages would show code and settings.
APP_DEBUG=false
APP_URL=https://rec.1005.date
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

# One log file a day in storage/logs (the storage-logs volume), kept 30 days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info

# DB_HOST and DB_PORT are set by docker-compose.yml (the «db» service).
DB_CONNECTION=pgsql
DB_DATABASE=recruitment
DB_USERNAME=recruitment_app
# «change»: the application's database password. It is given to the role when the database is first created;
# changing it later needs ALTER ROLE as well (docs/docker-deployment.md, troubleshooting).
DB_PASSWORD=

# The API keeps no session and queues nothing; the cache holds the rate limits and the scheduler's locks.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
MAIL_MAILER=log

# Only when another proxy or load balancer (a CDN, for example) sits in front of this server: its address(es),
# comma-separated. Empty when clients reach the web container directly.
TRUSTED_PROXIES=

# «change»: the exam halls' networks, as this server sees them (their public addresses when the halls reach it
# over the internet). Candidates log in only from these (addresses or CIDR ranges, comma-separated); empty
# refuses every candidate.
EXAMS_CANDIDATE_NETWORKS=
# A candidate may start until this many minutes after the start; candidates may log in this long before it.
EXAMS_LATE_MINUTES=15
EXAMS_LOGIN_EARLY_MINUTES=60
EXAMS_CANDIDATE_TOKEN_MINUTES=360

# The organization's day: staff tokens end at its midnight; report periods and contract dates follow it.
REPORTS_TIMEZONE=Asia/Damascus
REPORTS_ORGANIZATION="وزارة الدفاع السورية"
REPORTS_DEPARTMENT="إدارة التوجيه المعنوي  |  فرع القوة البشرية ــ قسم التوظيف"
REPORTS_MILITARY_ENTITY="التوجيه المعنوي"
# A PNG or JPG printed in the reports' header (optional): a path inside the container, under the storage-app volume.
# REPORTS_LOGO=/var/www/recruitment/storage/app/reports/logo.png
REPORTS_MAX_XLSX_ROWS=20000
REPORTS_MAX_PDF_ROWS=2000

CONTRACTS_ISSUING_UNIT="إدارة التوجيه المعنوي"
CONTRACTS_REMINDER_DAYS=14
CONTRACTS_VACANCY_MONTHS=3

# Upload limits in kilobytes. Caddy (request_body max_size) and PHP (upload_max_filesize) must allow the largest.
IMPORTS_MAX_FILE_KILOBYTES=30720
IMPORTS_MAX_ROWS=2000
DOCUMENTS_MAX_FILE_KILOBYTES=10240
CONTRACTS_VACANCIES_MAX_FILE_KILOBYTES=5120

# Only used when the frontend is served from another address than the API.
CORS_ALLOWED_ORIGINS=https://rec.1005.date
