# The web container (docs/docker-deployment.md): the frontend's build at /, the API at /api, on one HTTPS address.
#
# SITE_ADDRESS comes from .env. For a public name such as rec.1005.date Caddy obtains and renews a Let's Encrypt
# certificate by itself (ports 80 and 443 must be reachable from the internet, and the name must point here).
# For «localhost» it signs a certificate itself; «http://…» or «:80» serves plain HTTP (testing only).

{$SITE_ADDRESS:rec.1005.date} {
    encode zstd gzip

    # The largest upload: candidate imports up to 30 MB (IMPORTS_MAX_FILE_KILOBYTES), documents 10 MB.
    request_body {
        max_size 34MB
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # The API. Only Laravel's front controller (public/index.php) runs; nothing else of the backend is in this
    # container, and the documentation pages outside /api are not reachable.
    handle /api/* {
        root * /var/www/recruitment/public
        php_fastcgi app:9000 {
            # Large imports, approvals and exports take time (PHP's max_execution_time is 180 too).
            read_timeout 180s
        }
    }

    # The frontend, a single-page app: an unknown path is its index.html.
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    log
}
