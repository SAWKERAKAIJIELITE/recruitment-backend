# The web container (docs/docker-deployment.md): the frontend's build at /, the API at /api, on one HTTPS address.
#
# SITE_ADDRESS (docker-compose.yml):
#   :8080           plain HTTP on port WEB_PORT, behind the platform's proxy (Openship), which holds the certificate. The default.
#   rec.1005.date   Caddy obtains and renews a Let's Encrypt certificate itself (docker-compose.standalone.yml:
#                   ports 80 and 443 reachable from the internet, the name pointing here).
#   localhost       a certificate Caddy signs itself (a local test).

{
    # A proxy on this server or in Docker's networks is believed about the client's address and about HTTPS
    # (X-Forwarded-For, X-Forwarded-Proto); a client coming straight from the internet is not.
    servers {
        trusted_proxies static private_ranges
    }
}

{$SITE_ADDRESS::8080} {
    encode zstd gzip

    # The largest upload: candidate imports up to 30 MB (IMPORTS_MAX_FILE_KILOBYTES), documents 10 MB.
    request_body {
        max_size 34MB
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # The API. Only Laravel's front controller (public/index.php) runs; nothing else of the backend is in this
    # container, and the documentation pages outside /api are not reachable.
    handle /api/* {
        root * /var/www/recruitment/public
        php_fastcgi app:9000 {
            # Large imports, approvals and exports take time (PHP's max_execution_time is 180 too).
            read_timeout 180s
        }
    }

    # The frontend, a single-page app: an unknown path is its index.html.
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    log
}
